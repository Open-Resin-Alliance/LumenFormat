      "kind": "number",
      "defaultValue": 2,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "normal",
        "cardId": "normal-settings",
        "order": 10
      },
      "metadataPath": "material.normalExposureSec"
