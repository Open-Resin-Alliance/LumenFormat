  "fields": [
    {
      "key": "layerHeightMm",
      "label": "Layer Thickness (mm)",
      "kind": "number",
      "defaultValue": 0.05,
      "min": 0.001,
      "max": 1,
      "step": 0.001,
      "rowKey": "global-settings-row",
      "rowWeight": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "global",
        "cardId": "global-settings",
        "order": 10
      },
      "metadataPath": "material.layerHeightMm",
      "description": "How tall one layer is. A thinner layer holds more detail and prints more of them, so the print takes longer."
    },
    {
      "key": "elephantFootCompensation",
      "label": "Elephant's Foot Compensation",
      "kind": "boolean",
      "defaultValue": false,
      "disabled": true,
      "rowKey": "global-settings-row",
      "rowWeight": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "global",
        "cardId": "global-settings",
        "order": 20
      },
      "metadataPath": "material.elephantFootCompensation",
      "description": "Does nothing yet: no slicer applies an elephant's-foot compensation. The correction is made by insetting the bottom layers' masks in the geometry rather than in anything LUMEN records, so the input stays disabled until that lands."
    },
    {
      "key": "zstdLevel",
      "label": "File Compression Level",
      "kind": "select",
      "defaultValue": "6",
      "options": [
        {
          "value": "3",
          "label": "Low"
        },
        {
          "value": "6",
          "label": "Standard"
        },
        {
          "value": "9",
          "label": "High"
        },
        {
          "value": "19",
          "label": "Very High"
        }
      ],
      "placement": {
        "tabId": "meta",
        "sectionId": "file",
        "cardId": "scene-settings",
        "order": 20
      },
      "metadataPath": "lumen.zstdLevel",
      "description": "Compression of the layer frames, traded against slicing time. Very High is about 2.8% smaller than Standard and costs seconds of encoding on a large print; Low gives the largest file and slices fastest."
    },
    {
      "key": "bottomLayerCount",
      "label": "Burn-in Layers",
      "kind": "integer",
      "defaultValue": 5,
      "min": 0,
      "max": 200,
      "step": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "burn-in",
        "cardId": "burn-in-settings",
        "order": 10
      },
      "metadataPath": "material.bottomLayerCount",
      "description": "How many layers at the build plate cure with the burn-in exposure before the normal layers begin."
    },
    {
      "key": "transitionLayerCount",
      "label": "Transition Layers",
      "kind": "integer",
      "defaultValue": 0,
      "min": 0,
      "max": 100000,
      "step": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "burn-in",
        "cardId": "burn-in-settings",
        "order": 20
      },
      "metadataPath": "lumen.transitionLayerCount",
      "description": "Layers between the burn-in and normal exposures whose cure time steps from the burn-in value down to the normal one. 0 switches straight from one to the other."
    },
    {
      "key": "bottomExposureSec",
      "label": "Burn-in Exposure (s)",
      "kind": "number",
      "defaultValue": 25,
      "min": 0,
      "max": 300,
      "step": 0.1,
      "placement": {
        "tabId": "general",
        "sectionId": "burn-in",
        "cardId": "burn-in-settings",
        "order": 30
      },
      "metadataPath": "material.bottomExposureSec",
      "description": "How long a burn-in layer is exposed. The first layers have to bond to the build plate, so they cure far longer than the layers above them."
    },
    {
      "key": "normalExposureSec",
      "label": "Normal Exposure (s)",
      "kind": "number",
      "defaultValue": 2,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "normal",
        "cardId": "normal-settings",
        "order": 10
      },
      "metadataPath": "material.normalExposureSec",
      "description": "How long every layer above the burn-in ones is exposed. The resin's own cure time is the value to start from, and the first one to tune when a print comes out soft or over-cured."
    },
    {
      "key": "waitTimeBeforeCureSec",
      "label": "Wait Before Cure (s)",
      "kind": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "timing",
        "cardId": "timing-settings",
        "order": 10
      },
      "metadataPath": "lumen.waitTimeBeforeCureSec",
      "description": "Pause between the plate reaching position and the light turning on, which lets the resin come to rest before it cures."
    },
    {
      "key": "waitTimeAfterCureSec",
      "label": "Wait After Cure (s)",
      "kind": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "timing",
        "cardId": "timing-settings",
        "order": 20
      },
      "metadataPath": "lumen.waitTimeAfterCureSec",
      "description": "Pause between the exposure and the lift, which lets the cured layer set before it is peeled off the film."
    },
    {
      "key": "waitTimeAfterLiftSec",
      "label": "Wait After Lift (s)",
      "kind": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "timing",
        "cardId": "timing-settings",
        "order": 30
      },
      "metadataPath": "lumen.waitTimeAfterLiftSec",
      "description": "Pause at the top of the lift, before the plate starts back down for the next layer."
    },
    {
      "key": "projectorPwmPercent",
      "label": "Projector PWM (%)",
      "kind": "number",
      "defaultValue": 100,
      "min": 1,
      "max": 100,
      "step": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "light",
        "cardId": "light-settings",
        "order": 10
      },
      "metadataPath": "lumen.projectorPwmPercent",
      "description": "Ultraviolet power as a percentage of the projector's full output. Lower values dim every exposure and need longer cure times."
    },
    {
      "key": "bottomProjectorPwmPercent",
      "label": "Burn-in Projector PWM (%)",
      "kind": "number",
      "defaultValue": 100,
      "min": 1,
      "max": 100,
      "step": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "light",
        "cardId": "light-settings",
        "order": 20
      },
      "metadataPath": "lumen.bottomProjectorPwmPercent",
      "description": "The same power setting for the burn-in layers, which usually run at full output so the first layers bond to the plate."
    },
    {
      "key": "scaleCompensationXPct",
      "label": "Scale X (%)",
      "kind": "number",
      "defaultValue": 0,
      "min": -100,
      "max": 100,
      "step": 0.1,
      "disabled": true,
      "rowKey": "scale-compensation",
      "rowWeight": 1,
      "placement": {
        "tabId": "advanced",
        "sectionId": "scale",
        "cardId": "scale-settings",
        "order": 10
      },
      "metadataPath": "lumen.scaleCompensationXPct",
      "description": "Shrinkage compensation for the X axis, in percent. 0 leaves the material profile's own value alone, and the input stays disabled until the slicer applies a compensation."
    },
    {
      "key": "scaleCompensationYPct",
      "label": "Scale Y (%)",
      "kind": "number",
      "defaultValue": 0,
      "min": -100,
      "max": 100,
      "step": 0.1,
      "disabled": true,
      "rowKey": "scale-compensation",
      "rowWeight": 1,
      "placement": {
        "tabId": "advanced",
        "sectionId": "scale",
        "cardId": "scale-settings",
        "order": 20
      },
      "metadataPath": "lumen.scaleCompensationYPct",
      "description": "Shrinkage compensation for the Y axis, in percent. 0 leaves the material profile's own value alone, and the input stays disabled until the slicer applies a compensation."
    },
    {
      "key": "scaleCompensationZPct",
      "label": "Scale Z (%)",
      "kind": "number",
      "defaultValue": 0,
      "min": -100,
      "max": 100,
      "step": 0.1,
      "disabled": true,
      "rowKey": "scale-compensation",
      "rowWeight": 1,
      "placement": {
        "tabId": "advanced",
        "sectionId": "scale",
        "cardId": "scale-settings",
        "order": 30
      },
      "metadataPath": "lumen.scaleCompensationZPct",
      "description": "Shrinkage compensation for the Z axis, in percent. 0 leaves the material profile's own value alone, and the input stays disabled until the slicer applies a compensation."
    },
    {
      "key": "bottomLiftDistanceMm",
      "label": "Burn-in Lift Distance (mm)",
      "kind": "number",
      "defaultValue": 3,
      "min": 0,
      "max": 50,
      "step": 0.01,
      "placement": {
        "tabId": "motion",
        "sectionId": "burn-in-motion",
        "cardId": "burn-in-motion-settings",
        "order": 10
      },
      "metadataPath": "lumen.bottomLiftDistanceMm",
      "description": "How far a burn-in layer is lifted. The first, slow segment peels the layer off the film, which the sticky first layers need most, and the fast segment then travels its own distance. A 0 in the second distance makes the lift single-stage, so this distance carries the whole move.",
      "tag": "Slow",
      "color": "#f59e0b",
      "splitWithKey": "bottomLiftDistance2Mm"
    },
    {
      "key": "bottomLiftDistance2Mm",
      "label": "Burn-in Lift Distance 2 (mm)",
      "kind": "number",
      "defaultValue": 4,
      "tag": "Fast",
      "color": "#22c55e",
      "min": 0,
      "max": 50,
      "step": 0.01,
      "placement": {
        "tabId": "motion",
        "sectionId": "burn-in-motion",
        "cardId": "burn-in-motion-settings",
        "order": 10
      },
      "metadataPath": "lumen.bottomLiftDistance2Mm"
    },
    {
      "key": "bottomLiftSpeedMmMin",
      "label": "Burn-in Lift Speed (mm/min)",
      "kind": "number",
      "defaultValue": 60,
      "min": 0,
      "max": 100000,
      "step": 1,
      "placement": {
        "tabId": "motion",
        "sectionId": "burn-in-motion",
        "cardId": "burn-in-motion-settings",
        "order": 20
      },
      "metadataPath": "lumen.bottomLiftSpeedMmMin",
      "tag": "Slow",
      "color": "#f59e0b",
      "splitWithKey": "bottomLiftSpeed2MmMin",
      "description": "How fast the peel segment of a burn-in lift moves. Peeling slowly keeps the suction on the film low, which is what the first layers against the plate need. The second speed is used only when the second distance is non-zero; a 0 there makes the lift single-stage and the fast segment never happens."
    },
    {
      "key": "bottomLiftSpeed2MmMin",
      "label": "Burn-in Lift Speed 2 (mm/min)",
      "kind": "number",
      "defaultValue": 180,
      "tag": "Fast",
      "color": "#22c55e",
      "min": 0,
      "max": 100000,
      "step": 1,
      "placement": {
        "tabId": "motion",
        "sectionId": "burn-in-motion",
        "cardId": "burn-in-motion-settings",
        "order": 20
      },
      "metadataPath": "lumen.bottomLiftSpeed2MmMin"
    },
    {
      "key": "bottomRetractSpeedMmMin",
      "label": "Burn-in Retract Speed (mm/min)",
      "kind": "number",
      "defaultValue": 180,
      "min": 0,
      "max": 100000,
      "step": 1,
      "placement": {
        "tabId": "motion",
        "sectionId": "burn-in-motion",
