  "fields": [
    {
      "key": "layerHeightMm",
      "label": "Layer Thickness (mm)",
      "kind": "number",
      "defaultValue": 0.05,
      "min": 0.001,
      "max": 1,
      "step": 0.001,
      "placement": {
        "tabId": "general",
        "sectionId": "global",
        "cardId": "global-settings",
        "order": 10
      },
      "metadataPath": "material.layerHeightMm"
    },
    {
      "key": "zstdLevel",
      "label": "File Compression Level",
      "kind": "select",
      "defaultValue": "6",
      "options": [
        {
          "value": "3",
          "label": "Low"
        },
        {
          "value": "6",
          "label": "Standard"
        },
        {
          "value": "9",
          "label": "High"
        },
        {
          "value": "19",
          "label": "Very High"
        }
      ],
      "placement": {
        "tabId": "meta",
        "sectionId": "file",
        "cardId": "scene-settings",
        "order": 20
      },
      "metadataPath": "lumen.zstdLevel",
      "description": "Compression of the layer frames, traded against slicing time. Very High is about 2.8% smaller than Standard and costs seconds of encoding on a large print; Low gives the largest file and slices fastest."
    },
    {
      "key": "bottomLayerCount",
      "label": "Burn-in Layers",
      "kind": "integer",
      "defaultValue": 5,
      "min": 0,
      "max": 200,
      "step": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "burn-in",
        "cardId": "burn-in-settings",
        "order": 10
      },
      "metadataPath": "material.bottomLayerCount",
      "description": "How many layers at the build plate cure with the burn-in exposure before the normal layers begin."
    },
    {
      "key": "transitionLayerCount",
      "label": "Transition Layers",
      "kind": "integer",
      "defaultValue": 0,
      "min": 0,
      "max": 100000,
      "step": 1,
      "placement": {
        "tabId": "general",
        "sectionId": "burn-in",
        "cardId": "burn-in-settings",
        "order": 20
      },
      "metadataPath": "lumen.transitionLayerCount",
      "description": "Layers between the burn-in and normal exposures whose cure time steps from the burn-in value down to the normal one. 0 switches straight from one to the other."
    },
    {
      "key": "bottomExposureSec",
      "label": "Burn-in Exposure (s)",
      "kind": "number",
      "defaultValue": 25,
      "min": 0,
      "max": 300,
      "step": 0.1,
      "placement": {
        "tabId": "general",
        "sectionId": "burn-in",
        "cardId": "burn-in-settings",
