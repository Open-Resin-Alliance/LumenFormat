    {
      "key": "waitTimeBeforeCureSec",
      "label": "Wait Before Cure (s)",
      "kind": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "timing",
        "cardId": "timing-settings",
        "order": 10
      },
      "metadataPath": "lumen.waitTimeBeforeCureSec",
      "description": "Pause between the plate reaching position and the light turning on, which lets the resin come to rest before it cures."
    },
    {
      "key": "waitTimeAfterCureSec",
      "label": "Wait After Cure (s)",
      "kind": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "timing",
        "cardId": "timing-settings",
        "order": 20
      },
      "metadataPath": "lumen.waitTimeAfterCureSec",
      "description": "Pause between the exposure and the lift, which lets the cured layer set before it is peeled off the film."
    },
    {
      "key": "waitTimeAfterLiftSec",
      "label": "Wait After Lift (s)",
      "kind": "number",
      "defaultValue": 0,
      "min": 0,
      "max": 120,
      "step": 0.01,
      "placement": {
        "tabId": "general",
        "sectionId": "timing",
        "cardId": "timing-settings",
        "order": 30
      },
      "metadataPath": "lumen.waitTimeAfterLiftSec",
      "description": "Pause at the top of the lift, before the plate starts back down for the next layer."
    },
    {
      "key": "projectorPwmPercent",
